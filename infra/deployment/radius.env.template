# Dedicated RADIUS service env; chmod 600 after copying to .env.radius.
# Reuse existing database/key values exactly. Generate ONLY the new RADIUS secret.
DATABASE_URL=postgresql://RUNTIME_USER:ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full
VOUCHER_LOOKUP_KEY=REPLACE_WITH_EXISTING
VOUCHER_ENCRYPTION_KEY=REPLACE_WITH_EXISTING
NETWORK_PROVIDER=mikrotik
OMADA_MODE=live
MIKROTIK_RADIUS_ENABLED=true
MIKROTIK_RADIUS_BIND=10.77.0.1
MIKROTIK_RADIUS_CLIENT_IP=10.77.0.2
MIKROTIK_RADIUS_SECRET=REPLACE_WITH_NEW_64_HEX_SECRET
MIKROTIK_HOTSPOT_SERVER=babu-hotspot
MIKROTIK_RADIUS_GROUP=babu-vouchers
MIKROTIK_DEFAULT_DOWNLOAD_MBPS=5
MIKROTIK_DEFAULT_UPLOAD_MBPS=2
