# Copy to .env.api; keep mode mock until the RADIUS deployment and voucher checks are ready.
WIFI_BRAND="JIACHIE WIFI"
WIFI_SUPPORT_CONTACT=
APP_ORIGIN=https://wifi.example.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE
# Admin (service-role) key: the API uses it only to invite staff from the Staff page.
SUPABASE_SECRET_KEY=REPLACE
NETWORK_PROVIDER=mikrotik
WAN_DOWNLOAD_MBPS=150
WAN_UPLOAD_MBPS=
OMADA_MODE=mock
# Set true together with OMADA_MODE=live for deployed MikroTik RADIUS.
MIKROTIK_RADIUS_ENABLED=false
DATABASE_URL=postgresql://RUNTIME_USER:ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Preserve these existing keys when using your existing database.
VOUCHER_LOOKUP_KEY=REPLACE
VOUCHER_ENCRYPTION_KEY=REPLACE
PORTAL_CONTEXT_SECRET=REPLACE
MAX_BATCH_SIZE=100
API_HOST=0.0.0.0
API_PORT=4000
OMADA_MOCK_SCENARIO=success
# Legacy mock context only; replace with verified MikroTik context during implementation.
PORTAL_SITE=babu-shop
PORTAL_SSID="JIACHIE WIFI"
PORTAL_AP_MACS=AA:BB:CC:DD:EE:01
# Private WireGuard address. Certificate must include this IP in its SAN.
MIKROTIK_BASE_URL=https://10.77.0.2
MIKROTIK_USERNAME=babu-api-check
MIKROTIK_PASSWORD=REPLACE
MIKROTIK_CA_PATH=/run/secrets/mikrotik-ca.crt
MIKROTIK_HOTSPOT_SERVER=babu-hotspot

# Hotspot page uploads (Network > Router > Files). A second router account used
# only to put text files into the hotspot's page folder; everything else stays
# on the read-only account above. Create it in WinBox, pinned to the server:
#   /user group add name=portal-files policy=read,write,ftp,rest-api
#   /user add name=portal-files group=portal-files address=10.77.0.1/32 password=...
# Leave blank to keep the portal fully read-only.
MIKROTIK_FILES_USERNAME=
MIKROTIK_FILES_PASSWORD=
TRUST_PROXY=
# ── Self-service purchase. Blank key or secret = mobile payment off,
# cash counter unaffected. PUBLIC_API_URL must be the public HTTPS origin
# so Snippe can reach the webhook.
PUBLIC_API_URL=https://wifi.example.com
SNIPPE_API_KEY=REPLACE
SNIPPE_WEBHOOK_SECRET=REPLACE
SNIPPE_BASE_URL=https://api.snippe.sh

# Sale emails through Resend (https://resend.com). When both are set, every
# confirmed mobile-money purchase emails the owner its package, amount, network
# and receipt. Voucher codes are never included. Leave either blank to turn off.
RESEND_API_KEY=
# One address, or up to ten separated by commas.
SALE_ALERT_EMAIL=
# Sender. Resend only sends from a domain verified in its dashboard; until
# jiachie-wifi.com is verified, leave this blank to use onboarding@resend.dev,
# which Resend delivers only to the address that owns the Resend account.
RESEND_FROM=

# Owner sale alert by WhatsApp, through Makutano Connect (connect.makutano.co.tz).
# With a key and a number set, every paid self-service purchase also sends the
# owner a WhatsApp with the same details as the sale email, from the shop's
# Connect account. Create the key in Connect > API & webhooks (scope
# whatsapp:send). SALE_ALERT_WHATSAPP: the owner's number(s), comma separated
# (0752..., 255752... and +255 752... all work). Unset: nothing is queued.
CONNECT_API_KEY=
SALE_ALERT_WHATSAPP=
CONNECT_API_URL=https://connect.makutano.co.tz/api/v1
# WhatsApp accepts a business-started message only as a template Meta has
# approved; free text reaches the owner only within 24 hours of their own last
# message to the business number. Name the approved template here (created in
# Connect > WhatsApp > Templates) and the language it was approved in. Its
# variables are filled in this order unless CONNECT_SALE_TEMPLATE_FIELDS lists
# another: amount,package,access,speed,paid_with,paid_at,customer,receipt,reference,today,link
CONNECT_SALE_TEMPLATE=
CONNECT_SALE_TEMPLATE_LANG=en
CONNECT_SALE_TEMPLATE_FIELDS=
