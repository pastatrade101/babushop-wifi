# BABU-SHOP WIFI — copy to .env, never commit real credentials.
WIFI_BRAND="BABU-SHOP WIFI"
WIFI_SUPPORT_CONTACT=
APP_ORIGIN=http://127.0.0.1:5188
API_INTERNAL_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1
API_PORT=4000
# Supabase project settings. Staff authentication only; disable public signup.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Only the bootstrap CLI needs the admin/service-role key.
SUPABASE_SECRET_KEY=YOUR_BOOTSTRAP_SECRET_OR_SERVICE_ROLE_KEY
# Runtime connection: grant a login role babu_runtime membership; use SSL for hosted PG.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Optional trusted PostgreSQL CA override; Supabase CA is bundled for Supabase hosts.
DATABASE_CA_PATH=
# Privileged connection for seed/bootstrap; API/worker should not receive it in production.
DATABASE_ADMIN_URL=postgresql://ADMIN:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Generate three different secrets with: openssl rand -hex 32
VOUCHER_LOOKUP_KEY=REPLACE_WITH_64_HEX_CHARACTERS
VOUCHER_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
PORTAL_CONTEXT_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
MAX_BATCH_SIZE=100
# Mock mode does not authorize real internet.
OMADA_MODE=mock
OMADA_MOCK_SCENARIO=success
PORTAL_SITE=babu-shop
PORTAL_SSID=BABU-SHOP WIFI
PORTAL_AP_MACS=AA:BB:CC:DD:EE:01
# LIVE ONLY: HTTPS controller over private network/VPN. No browser-provided destinations.
OMADA_BASE_URL=https://controller.internal:8043
OMADA_CONTROLLER_ID=
OMADA_OPERATOR_USERNAME=
OMADA_OPERATOR_PASSWORD=
# legacy-pre511 / legacy / modern — must match commissioned controller version.
OMADA_PROFILE=
# milliseconds / microseconds; timestamp / duration; number / string.
# Select only after verifying real controller behavior against commissioning guide.
OMADA_TIME_UNIT=
OMADA_TIME_MEANING=
OMADA_FIELD_TYPE=
OMADA_EXPIRY_VERIFIED=false
OMADA_CA_PATH=
# Leave empty unless behind your own trusted proxy; use an explicit address/CIDR.
TRUST_PROXY=

# Network preparation: no live router access until hardware commissioning.
NETWORK_PROVIDER=mikrotik
WAN_DOWNLOAD_MBPS=150
# Confirm actual upload capacity; do not assume symmetrical fibre.
WAN_UPLOAD_MBPS=
MIKROTIK_BASE_URL=
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_CA_PATH=
MIKROTIK_HOTSPOT_SERVER=babu-hotspot

# ── Self-service purchase (optional) ─────────────────────────────
# Blank SNIPPE_API_KEY or SNIPPE_WEBHOOK_SECRET disables mobile payment
# entirely: /buy says so plainly and the cash counter is unaffected.
# Public HTTPS origin of the API, used to build the webhook URL Snippe posts to.
PUBLIC_API_URL=
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_BASE_URL=https://api.snippe.sh

# Which provider takes the money. Explicit, so leaving an old provider's
# credentials in place cannot quietly change who is charged. Leave blank to use
# whichever is fully configured, preferring AzamPay.
PAYMENT_PROVIDER=

# AzamPay. Mobile-money push: the buyer stays on our page and approves on their
# handset. All four are required before it will be used.
AZAM_APP_NAME=Makutano-app
AZAM_CLIENT_ID=18512733-5a9c-4bc6-bbf1-d0285b0e515a
AZAM_CLIENT_
# Shared secret for our own callback URL. AzamPay does not sign callbacks, so
# this is the last path segment of the URL you register with them:
#   https://<your domain>/api/v1/portal/payments/webhook/azam/<AZAM_CALLBACK_TOKEN>
# Generate with: openssl rand -hex 32
AZAM_CALLBACK_TOKEN=3adbfad4-943b-4f93-aab8-e859e0987206
# Sandbox: https://authenticator-sandbox.azampay.co.tz and https://sandbox.azampay.co.tz
AZAM_AUTH_URL=https://authenticator.azampay.co.tz
AZAM_BASE_URL=https://checkout.azampay.co.tz
# Post the checkout somewhere other than AzamPay directly -- a settling
# partner's gateway in front of it. https only. Leave blank to go direct.
AZAM_CHECKOUT_URL=
# The tag that marks a transaction as ours, so the settling partner knows which
# payments to disburse to us. It must match the name they expect, exactly.
AZAM_SOURCE=Pastory
# Required before a payment can be confirmed out of band, which is the only way
# a voucher is released on an unsigned callback. Ask AzamPay for the bankName
# value their transaction-status endpoint expects for your account.
AZAM_STATUS_BANK=
